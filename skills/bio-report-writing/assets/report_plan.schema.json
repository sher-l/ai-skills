{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "module", "title", "audience", "quality_profile", "effort_profile", "max_repair_rounds", "result_layout", "evidence_pack", "template", "evidence_targets", "sections", "output_policy"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "module": {"type": "string", "minLength": 1},
    "mode": {"enum": ["module", "one_off"]},
    "title": {"type": "string", "minLength": 1},
    "audience": {"type": "string", "minLength": 1},
    "quality_profile": {"enum": ["draft", "release"]},
    "effort_profile": {"enum": ["mechanical", "scientific_review"]},
    "max_repair_rounds": {"type": "integer", "minimum": 0, "maximum": 2},
    "result_layout": {"const": "flat"},
    "evidence_pack": {"type": "string", "minLength": 1},
    "template": {"type": "string", "minLength": 1},
    "evidence_targets": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "title"], "properties": {"id": {"type": "string", "minLength": 1}, "title": {"type": "string", "minLength": 1}, "analysis_point_ids": {"type": "array", "items": {"type": "string", "minLength": 1}}}}},
    "sections": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "title", "required", "analysis_point_ids"], "properties": {"id": {"type": "string", "minLength": 1}, "title": {"type": "string", "minLength": 1}, "required": {"type": "boolean"}, "analysis_point_ids": {"type": "array", "items": {"type": "string"}}, "semantic": {"oneOf": [{"type": "string"}, {"type": "array", "items": {"type": "string"}}]}}}},
    "output_policy": {"type": "object", "additionalProperties": false, "required": ["report_file"], "properties": {"report_file": {"type": "string", "minLength": 1}, "include_pdf": {"type": "boolean"}}}
  }
}
