#!/usr/bin/env Rscript
# DOCX-first report renderer example.
# Copy this file and scripts/render_docx_template.py into a module.  Replace
# the default pack-to-slot mapping when the module has several analysis points;
# keep the mapping explicit and let the shared helper fill report_template.docx.
args <- commandArgs(trailingOnly = TRUE)
if (length(args) != 4L) stop("usage: generate_report.R INPUT_ROOT PACK.json TEMPLATE_DIR OUTPUT_DIR")
root <- normalizePath(args[[1L]], mustWork = TRUE)
pack <- normalizePath(args[[2L]], mustWork = TRUE)
template <- normalizePath(file.path(args[[3L]], "report_template.docx"), mustWork = TRUE)
output <- normalizePath(args[[4L]], mustWork = FALSE)
helper <- Sys.getenv("BIO_REPORT_TEMPLATE_HELPER", unset = "scripts/render_docx_template.py")
if (!file.exists(helper)) stop("copy scripts/render_docx_template.py or set BIO_REPORT_TEMPLATE_HELPER")
dir.create(output, recursive = TRUE, showWarnings = FALSE)
work <- tempfile("report-render-"); dir.create(work)
on.exit(unlink(work, recursive = TRUE, force = TRUE), add = TRUE)
rendered <- file.path(work, "report.docx")
status <- system2(Sys.getenv("PYTHON", unset = "python"), c(
  helper, "--template", template, "--evidence-pack", pack,
  "--root", root, "--output", rendered, "--final"
))
if (!identical(status, 0L)) stop("DOCX template rendering failed")
pack_text <- paste(readLines(pack, warn = FALSE, encoding = "UTF-8"), collapse = " ")
module_match <- regexec('"module"[[:space:]]*:[[:space:]]*"([^"]+)"', pack_text)
module_id <- regmatches(pack_text, module_match)[[1L]][2L]
if (is.na(module_id) || !nzchar(module_id)) stop("evidence pack module is required")
destination <- file.path(output, paste0(module_id, "_report.docx"))
if (!file.copy(rendered, destination, overwrite = TRUE)) stop("could not publish report")
cat(destination, "\n")
