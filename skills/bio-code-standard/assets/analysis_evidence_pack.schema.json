{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "module", "quality_profile", "result_layout", "evidence_targets", "analysis_points"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "module": {"type": "string", "minLength": 1},
    "quality_profile": {"enum": ["draft", "release"]},
    "result_layout": {"enum": ["flat", "module_contract"]},
    "title": {"type": "string"},
    "audience": {"type": "string"},
    "references": {"type": "array", "items": {"$ref": "#/$defs/source"}},
    "versions": {"type": "array", "items": {"$ref": "#/$defs/source"}},
    "evidence_targets": {"type": "array", "items": {"$ref": "#/$defs/target"}},
    "analysis_points": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/point"}}
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {"name": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "source": {"type": "string"}, "purpose": {"type": "string"}}
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title"],
      "properties": {"id": {"type": "string", "minLength": 1}, "title": {"type": "string", "minLength": 1}, "analysis_point_ids": {"type": "array", "items": {"type": "string", "minLength": 1}}}
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "identity"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "identity": {"type": "string", "minLength": 1},
        "kind": {"type": "string"},
        "unit": {"type": "string"},
        "orientation": {"type": "string"}
      }
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {"name": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "citation": {"type": "string"}}
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "reference", "direction"],
      "properties": {"target": {"type": "string", "minLength": 1}, "reference": {"type": "string", "minLength": 1}, "metric": {"type": "string"}, "direction": {"type": "string", "minLength": 1}}
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value", "unit", "source"],
      "properties": {"name": {"type": "string", "minLength": 1}, "value": {}, "unit": {"type": "string", "minLength": 1}, "source": {"type": "string", "minLength": 1}}
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "kind", "published", "purpose", "consumers"],
      "properties": {"id": {"type": "string", "minLength": 1}, "path": {"type": "string", "minLength": 1}, "kind": {"type": "string", "minLength": 1}, "published": {"type": "boolean"}, "purpose": {"type": "string", "minLength": 1}, "consumers": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "path"],
      "properties": {"kind": {"enum": ["figure", "table"]}, "id": {"type": "string", "minLength": 1}, "path": {"type": "string", "minLength": 1}, "caption": {"type": "string"}}
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "scope", "inputs", "method", "parameters", "results", "outputs", "figure_table_refs", "limitations", "status"],
      "properties": {
        "id": {"type": "string", "pattern": "^AP-[0-9]{2,}$"},
        "title": {"type": "string", "minLength": 1},
        "scope": {"type": "string", "minLength": 1},
        "qc": {"type": "string", "minLength": 1},
        "inputs": {"type": "array", "items": {"$ref": "#/$defs/input"}},
        "method": {"$ref": "#/$defs/method"},
        "parameters": {"type": "object"},
        "statistical_unit": {"type": "string", "minLength": 1},
        "comparison": {"$ref": "#/$defs/comparison"},
        "results": {"type": "array", "items": {"$ref": "#/$defs/result"}},
        "outputs": {"type": "array", "items": {"$ref": "#/$defs/output"}},
        "figure_table_refs": {"type": "array", "items": {"$ref": "#/$defs/reference"}},
        "interpretation_level": {"type": "string", "enum": ["descriptive", "association", "prediction", "candidate", "mechanistic_hint"]},
        "interpretation": {"type": "string", "minLength": 1},
        "next_step": {"type": "string"},
        "limitations": {"type": "array", "items": {"type": "string"}},
        "status": {"type": "string", "enum": ["complete", "valid_no_findings", "evidence_missing", "blocked"]}
      }
    }
  }
}
