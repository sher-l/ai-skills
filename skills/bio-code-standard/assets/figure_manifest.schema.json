{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "figures"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "result_layout": {"enum": ["flat", "module_contract"]},
    "figures": {"type": "array", "items": {"$ref": "#/$defs/figure"}}
  },
  "$defs": {
    "figure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source", "formats", "width", "height", "dpi", "font", "renderer", "provenance"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "formats": {"type": "array", "items": {"enum": ["png", "pdf"]}, "minItems": 1, "uniqueItems": true},
        "width": {"type": "number", "exclusiveMinimum": 0},
        "height": {"type": "number", "exclusiveMinimum": 0},
        "dpi": {"type": "number", "exclusiveMinimum": 0},
        "font": {"type": "string", "minLength": 1},
        "renderer": {"type": "string", "minLength": 1},
        "provenance": {"type": "object", "minProperties": 1},
        "source_code": {"type": "string", "minLength": 1},
        "data_sources": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "run_record": {"type": "string", "minLength": 1},
        "panels": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "crop": {"enum": [false, null]},
        "split": {"enum": [false, null]}
      }
    }
  }
}
